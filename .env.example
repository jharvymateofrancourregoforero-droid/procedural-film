# En Claude Code en la nube, pon estas variables en el entorno (claude.ai/code → entorno → Variables de entorno).
# Alternativa más segura (Pro/Max): guarda ELEVENLABS y PEXELS como "Credenciales de API" del entorno
# y aquí escribe solo el valor proxy (ej. ELEVENLABS_API_KEY=proxy).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional: eleven_multilingual_v2 (calidad, por defecto) o eleven_flash_v2_5 (más barato)
ELEVENLABS_MODEL=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Opcional (tendencias de YouTube)
YOUTUBE_API_KEY=
